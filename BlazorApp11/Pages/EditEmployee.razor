@page "/EditEmployee/{Id}"
@using BlazorApp11.Data
@inject EmployeeService employeeService
@inject NavigationManager NavigationManager
<h3>Edit Employee</h3>
<hr />
<form>
    <div class="row">
        <div class="col-md-8">
            <div class="for-group">
                <label for="Id" class="control-label">Id</label>
                <input form="Id" class="form-control" @bind="@obj.Id" />
            </div>
            <div class="for-group">
                <label for="Name" class="control-label">Name</label>
                <input form="Name" class="form-control" @bind="@obj.Name" />
            </div>
            <div class="for-group">
                <label for="Name" class="control-label">Email</label>
                <input form="Name" class="form-control" @bind="@obj.Email" />
            </div>
            <div class="for-group">
                <label for="Name" class="control-label">IsActive</label>
                <input form="Name" class="form-control" @bind="@obj.IsActive" />
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <input typeof="button" class="btn btn-primary" @onclick="@UpdateEmployee" value="Update Employee" />

                <input typeof="button" class="btn btn-danger" @onclick="@Cancel" value="Cancel" />
            </div>
        </div>

    </div>
</form>

@code {   
    [Parameter]  
    public string Id { get; set; }
    Employee obj = new Employee();
    protected override async Task OnInitializedAsync()
    {
        obj = await Task.Run(() => employeeService.GetEmployeeById(Convert.ToInt32(Id)));
    }
    protected async void UpdateEmployee()
    {
        await employeeService.UpdateEmployee(obj);
        NavigationManager.NavigateTo("Employees");
    }
    protected async void Cancel()
    {
        NavigationManager.NavigateTo("Employees");
    }
    
}
